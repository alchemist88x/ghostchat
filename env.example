# ==========================================
# GHOSTCHAT ENVIRONMENT CONFIGURATION EXAMPLE
# ==========================================

# 1. MongoDB Atlas (Database Connection)
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/ghostchat?retryWrites=true&w=majority

# 2. Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. Ably Realtime Key (From https://ably.com)
ABLY_API_KEY=your_ably_api_key_here

# 4. Media Storage Configuration (AWS S3 or Cloudflare R2)
FILESYSTEM_DISK=s3
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
S3_REGION=us-east-1
S3_BUCKET=your_s3_bucket_name
S3_ENDPOINT=https://your_s3_bucket_name.s3.us-east-1.amazonaws.com
S3_CLOUDFRONT_URL=https://your_cloudfront_distribution.cloudfront.net

# Optional Cloudflare R2 Alternative Configuration:
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=your_r2_bucket_name
# R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
# R2_PUBLIC_URL=https://media.yourdomain.com

# 5. Upstash Redis (Optional Rate Limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 6. Session Security Secret
SESSION_SECRET=your_super_secret_32_character_string_here

# 7. Cron Cleanup Authorization Secret
CRON_SECRET=your_cron_cleanup_secret_here

# 8. Business Limits & Ephemeral Retention
CHAT_EXPIRATION_HOURS=72
MAX_CHAT_PARTICIPANTS=50

MAX_IMAGE_SIZE_MB=10
MAX_VOICE_SIZE_MB=20
MAX_FILE_SIZE_MB=25
